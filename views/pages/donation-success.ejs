<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Donation Successful - Manorama Charitable Trust
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #f5f7fa,
                    #e8eef5
                );
        }

        .success-wrapper {
            width: 100%;
            max-width: 650px;
            padding: 20px;
        }

        .success-card {
            background: #ffffff;

            border-radius: 16px;

            padding: 40px 35px;

            text-align: center;

            box-shadow:
                0 12px 40px
                rgba(0, 0, 0, 0.12);
        }

        .success-icon {
            width: 75px;
            height: 75px;

            margin: 0 auto 20px;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #e8f7ed;

            color: #198754;

            font-size: 42px;
            font-weight: bold;
        }

        .success-card h1 {
            margin: 0 0 10px;

            font-size: 28px;

            color: #198754;
        }

        .subtitle {
            color: #555;

            line-height: 1.6;

            margin-bottom: 25px;
        }

        .payment-details {
            text-align: left;

            border: 1px solid #e2e2e2;

            border-radius: 10px;

            overflow: hidden;

            margin: 25px 0;
        }

        .detail-row {
            display: flex;

            justify-content: space-between;

            gap: 20px;

            padding: 13px 16px;

            border-bottom: 1px solid #eeeeee;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: #666;

            font-size: 14px;
        }

        .detail-value {
            color: #222;

            font-weight: 600;

            font-size: 14px;

            text-align: right;

            word-break: break-word;
        }

        .amount-row {
            background: #f8f9fa;
        }

        .amount-value {
            font-size: 18px;

            color: #198754;
        }

        .email-status {
            padding: 14px;

            border-radius: 8px;

            background: #f0f7ff;

            color: #24527a;

            font-size: 14px;

            line-height: 1.5;

            margin-bottom: 25px;
        }

        .actions {
            display: flex;

            justify-content: center;

            gap: 12px;

            flex-wrap: wrap;
        }

        .action-btn {
            display: inline-block;

            padding: 12px 20px;

            border-radius: 7px;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;
        }

        .download-btn {
            background: #198754;

            color: #ffffff;
        }

        .home-btn {
            background: #eeeeee;

            color: #333333;
        }

        .note {
            margin-top: 25px;

            font-size: 12px;

            color: #777;

            line-height: 1.5;
        }

        @media (max-width: 600px) {

            .success-wrapper {
                padding: 15px;
            }

            .success-card {
                padding: 30px 20px;
            }

            .success-card h1 {
                font-size: 24px;
            }

            .detail-row {
                flex-direction: column;

                gap: 5px;
            }

            .detail-value {
                text-align: left;
            }

            .actions {
                flex-direction: column;
            }

            .action-btn {
                width: 100%;
            }

        }

    </style>

</head>


<body>


<div class="success-wrapper">

    <div class="success-card">


        <!-- SUCCESS ICON -->

        <div class="success-icon">
            ✓
        </div>


        <!-- SUCCESS MESSAGE -->

        <h1>
            Donation Successful
        </h1>


        <p class="subtitle">

            Thank you for your generous contribution
            to <strong>Manorama Charitable Trust</strong>.

            Your payment has been successfully processed.

        </p>


        <!-- PAYMENT DETAILS -->

        <div class="payment-details">


            <div class="detail-row">

                <span class="detail-label">
                    Transaction ID
                </span>

                <span class="detail-value">
                    <%= transactionId %>
                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    PayU Payment ID
                </span>

                <span class="detail-value">

                    <%= paymentId || "Not Available" %>

                </span>

            </div>


            <div class="detail-row amount-row">

                <span class="detail-label">
                    Donation Amount
                </span>

                <span class="detail-value amount-value">

                    ₹<%= Number(donation.amount).toFixed(2) %>

                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Cause
                </span>

                <span class="detail-value">

                    <%= donation.causeForDonation %>

                </span>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Donor
                </span>

                <span class="detail-value">

                    <%= donation.donorName %>

                </span>

            </div>


        </div>


        <!-- EMAIL STATUS -->

        <% if (emailSent) { %>

            <div class="email-status">

                📧 Your official donation receipt has been
                sent to

                <strong>
                    <%= donation.email %>
                </strong>

                as a PDF attachment.

            </div>

        <% } else { %>

            <div class="email-status">

                Your payment was successful, but the email
                receipt could not be sent right now.

                Please download your receipt below.

            </div>

        <% } %>


        <!-- BUTTONS -->

        <div class="actions">


            <a
                href="<%= receiptUrl %>"
                class="action-btn download-btn"
                id="downloadReceipt"
            >
                Download Receipt
            </a>


            <a
                href="/"
                class="action-btn home-btn"
            >
                Back to Home
            </a>


        </div>


        <p class="note">

            Your receipt is generated after successful
            payment verification. Please keep it for your records.

        </p>


    </div>

</div>


<!-- ======================================== -->
<!-- AUTOMATIC PDF DOWNLOAD -->
<!-- ======================================== -->

<script>

window.addEventListener("load", function () {

    const receiptUrl =
        "<%= receiptUrl %>";

    if (!receiptUrl) {
        return;
    }

    setTimeout(function () {

        const link =
            document.createElement("a");

        link.href = receiptUrl;

        link.setAttribute(
            "download",
            "donation-receipt-<%= transactionId %>.pdf"
        );

        link.style.display = "none";

        document.body.appendChild(link);

        link.click();

        setTimeout(function () {
            document.body.removeChild(link);
        }, 1000);

    }, 1200);

});

</script>


</body>

</html>