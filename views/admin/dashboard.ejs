<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Admin Dashboard - Manorama Charitable Trust
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        .admin-container {
            width: 95%;
            max-width: 1400px;
            margin: 40px auto;
        }

        .admin-card {
            background: white;
            padding: 30px;
            border-radius: 14px;

            box-shadow:
                0 10px 35px
                rgba(0, 0, 0, 0.10);

            margin-bottom: 30px;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .admin-header h1 {
            margin: 0;
        }

        .stats {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(180px, 1fr));

            gap: 20px;

            margin-top: 25px;
        }

        .stat-card {
            padding: 20px;

            border-radius: 10px;

            background: #f5f7fa;

            text-align: center;
        }

        .stat-card h3 {
            margin: 0 0 10px;
        }

        .stat-number {
            font-size: 30px;
            font-weight: bold;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;

            border-collapse: collapse;

            min-width: 1000px;
        }

        th,
        td {
            padding: 12px;

            border-bottom:
                1px solid #ddd;

            text-align: left;

            vertical-align: top;
        }

        th {
            background: #f5f5f5;

            white-space: nowrap;
        }

        td {
            max-width: 250px;

            word-break: break-word;
        }

        .status-success {
            font-weight: bold;
        }

        .empty-message {
            color: #666;

            text-align: center;

            padding: 20px;
        }

        .logout-form {
            margin: 0;
        }

        .section-title {
            margin-bottom: 20px;
        }

        @media (max-width: 600px) {

            .admin-container {
                width: 92%;

                margin: 20px auto;
            }

            .admin-card {
                padding: 20px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body class="page-bg">


<main class="admin-container">


    <!-- ================================= -->
    <!-- ADMIN HEADER -->
    <!-- ================================= -->

    <section class="admin-card">

        <div class="admin-header">

            <div>

                <h1>
                    Admin Dashboard
                </h1>

                <p>
                    Manorama Charitable Trust
                </p>

            </div>


            <form
                class="logout-form"
                action="/admin/logout"
                method="POST"
            >

                <button
                    type="submit"
                    class="btn red"
                >
                    Logout
                </button>

            </form>

        </div>


        <!-- ================================= -->
        <!-- STATISTICS -->
        <!-- ================================= -->

        <div class="stats">

            <div class="stat-card">

                <h3>
                    Donations
                </h3>

                <div class="stat-number">
                    <%= donationCount %>
                </div>

            </div>


            <div class="stat-card">

                <h3>
                    Medical Requests
                </h3>

                <div class="stat-number">
                    <%= medicalCount %>
                </div>

            </div>

        </div>

    </section>



    <!-- ================================= -->
    <!-- DONATION RECORDS -->
    <!-- ================================= -->

    <section class="admin-card">

        <h2 class="section-title">
            Donation Records
        </h2>


        <% if (donations.length === 0) { %>

            <p class="empty-message">
                No donation records found.
            </p>

        <% } else { %>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>
                                Donor Name
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Cause
                            </th>

                            <th>
                                Payment Mode
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Transaction ID
                            </th>

                            <th>
                                PayU Payment ID
                            </th>

                            <th>
                                Message
                            </th>

                            <th>
                                Payment Date
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% donations.forEach((donation, index) => { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>


                                <td>
                                    <%= donation.donorName || "-" %>
                                </td>


                                <td>
                                    <%= donation.phoneNumber || "-" %>
                                </td>


                                <td>
                                    <%= donation.email || "-" %>
                                </td>


                                <td>
                                    ₹ <%= donation.amount || "-" %>
                                </td>


                                <td>
                                    <%= donation.causeForDonation || "-" %>
                                </td>


                                <td>
                                    <%= donation.paymentMode || "-" %>
                                </td>


                                <td class="status-success">

                                    <%= donation.paymentStatus || "-" %>

                                </td>


                                <td>
                                    <%= donation.transactionId || "-" %>
                                </td>


                                <td>
                                    <%= donation.payuPaymentId || "-" %>
                                </td>


                                <td>
                                    <%= donation.message || "-" %>
                                </td>


                                <td>
                                    <%= donation.paymentDate || "-" %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>


        <% } %>

    </section>



    <!-- ================================= -->
    <!-- MEDICAL RECORDS -->
    <!-- ================================= -->

    <section class="admin-card">

        <h2 class="section-title">
            Medical Records
        </h2>


        <% if (medicalRecords.length === 0) { %>

            <p class="empty-message">
                No medical records found.
            </p>

        <% } else { %>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>
                                Patient Name
                            </th>

                            <th>
                                Aadhaar Number
                            </th>

                            <th>
                                Date of Birth
                            </th>

                            <th>
                                Reference Name
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Disease
                            </th>

                            <th>
                                Hospital
                            </th>

                            <th>
                                Registration Number
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% medicalRecords.forEach((record, index) => { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>


                                <td>
                                    <%= record.patientName || "-" %>
                                </td>


                                <td>
                                    <%= record.aadharNumber || "-" %>
                                </td>


                                <td>
                                    <%= record.dateBirth || "-" %>
                                </td>


                                <td>
                                    <%= record.patientReferenceName || "-" %>
                                </td>


                                <td>
                                    <%= record.patientPhoneNumber || "-" %>
                                </td>


                                <td>
                                    <%= record.patientEmail || "-" %>
                                </td>


                                <td>
                                    <%= record.nameDiseases || "-" %>
                                </td>


                                <td>
                                    <%= record.hospitalName || "-" %>
                                </td>


                                <td>
                                    <%= record.referenceRegistrationNumber || "-" %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>


        <% } %>

    </section>



    <!-- ================================= -->
    <!-- HOME -->
    <!-- ================================= -->

    <div style="text-align: center;">

        <a href="/">
            Back to Home
        </a>

    </div>


</main>


</body>

</html>